{
  "clients": {
    "openai": {
      "provider": "openai"
    },
    "openrouter": {
      "provider": "openai"
    },
    "ollama": {
      "provider": "ollama",
      "base_url_env": "OLLAMA_ENDPOINT"
    }
  },
  "models": [
    {
      "name": "gpt-4o-mini",
      "client": "openai",
      "enabled": true,
      "description": "OpenAI GPT-4o-mini - Fast and cost-effective"
    },
    {
      "name": "qwen/qwen3-next-80b-a3b-instruct",
      "client": "openrouter",
      "enabled": true,
      "description": "Qwen3 Next 80B via OpenRouter"
    },
    {
      "name": "qwen2.5:7b-instruct",
      "client": "ollama",
      "enabled": false,
      "description": "Qwen 2.5 7B via Ollama - Local model"
    }
  ],
  "metadata": {
    "version": "2.0",
    "description": "Default model configurations for conflict classifier benchmark",
    "note": "Set OPENAI_API_KEY and optionally OLLAMA_ENDPOINT environment variables"
  }
}
